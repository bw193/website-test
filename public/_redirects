# Bare root → default language so crawlers see a 301, not a thin SPA shell.
/              /en/                    301

# Legacy non-prefixed public URLs → /en/*/ (preserves any inbound links from
# before language routing; trailing slash matches Cloudflare Pages directory
# serving so there's no second redirect hop).
/products      /en/products/           301
/products/*    /en/products/:splat/    301
/our-story     /en/our-story/          301
/rfq           /en/rfq/                301
/solutions     /en/solutions/          301
/solutions/*   /en/solutions/:splat/   301
/videos        /en/videos/             301
/videos/*      /en/videos/:splat/      301
/insights      /en/insights/           301
/insights/:slug  /en/insights/:slug/   301
/insights/:slug/ /en/insights/:slug/   301

# Public Journal URLs moved to the clearer Insights directory. Keep these
# permanent, one-hop redirects so existing links retain their search signals.
/blog          /en/insights/           301
/blog/:slug    /en/insights/:slug/     301
/blog/:slug/   /en/insights/:slug/     301
/en/blog       /en/insights/           301
/en/blog/:slug  /en/insights/:slug/    301
/en/blog/:slug/ /en/insights/:slug/    301
/zh/blog       /zh/insights/           301
/zh/blog/:slug  /zh/insights/:slug/    301
/zh/blog/:slug/ /zh/insights/:slug/    301
/es/blog       /es/insights/           301
/es/blog/:slug  /es/insights/:slug/    301
/es/blog/:slug/ /es/insights/:slug/    301
/fr/blog       /fr/insights/           301
/fr/blog/:slug  /fr/insights/:slug/    301
/fr/blog/:slug/ /fr/insights/:slug/    301
/de/blog       /de/insights/           301
/de/blog/:slug  /de/insights/:slug/    301
/de/blog/:slug/ /de/insights/:slug/    301
/it/blog       /it/insights/           301
/it/blog/:slug  /it/insights/:slug/    301
/it/blog/:slug/ /it/insights/:slug/    301

# The bare category index has no page of its own (React only redirected it
# client-side, so crawlers saw the 404 page). worker/reliable-entry.ts issues
# the same 301 when the request reaches the Worker; these cover the asset layer.
/en/products/category   /en/products/  301
/en/products/category/  /en/products/  301
/zh/products/category   /zh/products/  301
/zh/products/category/  /zh/products/  301
/es/products/category   /es/products/  301
/es/products/category/  /es/products/  301
/fr/products/category   /fr/products/  301
/fr/products/category/  /fr/products/  301
/de/products/category   /de/products/  301
/de/products/category/  /de/products/  301
/it/products/category   /it/products/  301
/it/products/category/  /it/products/  301

# Missing pages are handled by wrangler.jsonc's `not_found_handling: "404-page"`
# (dist/404.html, generated by scripts/prerender-static.ts, served with HTTP 404)
# — do NOT add `/* /index.html 200` here; Cloudflare Workers Static Assets flags it as
# a redirect loop (code 10021).
