{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website-test",
  "main": "./worker/reliable-entry.ts",
  "compatibility_date": "2026-08-26",
  "keep_vars": true,
  "routes": [
    {
      "pattern": "bolenmirror.com/*",
      "zone_name": "bolenmirror.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SUPABASE_URL": "https://mxmmffwntosvwaviippd.supabase.co"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "846201731",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
